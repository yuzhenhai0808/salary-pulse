{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salary Pulse",
  "version": "0.1.0",
  "identifier": "com.yuzhenhai.salarypulse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Salary Pulse",
        "width": 920,
        "height": 690,
        "minWidth": 640,
        "minHeight": 540,
        "visible": false
      },
      {
        "label": "floating",
        "title": "Salary Pulse",
        "url": "index.html?view=floating",
        "width": 290,
        "height": 158,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": ["main", "floating"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "shortDescription": "Your private workday companion",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "../resources/Info.plist"
    }
  }
}
